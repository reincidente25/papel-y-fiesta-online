# functions/env.example
# Copiá este archivo como functions/.env y completá los valores.
# IMPORTANTE: acá van SOLO datos NO secretos (config). Los secretos (tokens,
# claves, contraseñas) se cargan con `firebase functions:secrets:set NOMBRE`.
# El .env está en .gitignore, así que no se sube al repo.

# ── Brevo (emails) ─────────────────────────────────────────────
BREVO_SENDER_EMAIL=hola@papelyfiesta.com
BREVO_SENDER_NAME=Papel & Fiesta
ADMIN_NOTIFY_EMAIL=admin@papelyfiesta.com
SITE_URL=https://papelyfiesta.com

# ── Envia.com (envíos) ─────────────────────────────────────────
# El token va por secret: firebase functions:secrets:set ENVIA_TOKEN
ENVIA_ENV=prod
ENVIA_ORIGEN_CP=1407
ENVIA_ORIGEN_ESTADO=Ciudad Autónoma de Buenos Aires
ENVIA_ORIGEN_CIUDAD=Ciudad Autónoma de Buenos Aires
# Correos a cotizar, separados por coma. Vacío = todos (andreani, correoArgentino, oca, urbano).
# Para mostrar SOLO Correo Argentino:
ENVIA_CARRIERS=correoArgentino

# ── Peso / estimador de respaldo ───────────────────────────────
ENVIO_PESO_ESTANDAR_G=500
ENVIO_FALLBACK_BASE=2500
ENVIO_FALLBACK_POR_KG=1200

# ── Correo Argentino (opcional, si algún día te habilitan la API) ─
# Credenciales por secret; acá solo el CP de origen:
CA_ENV=prod
CA_CP_ORIGEN=1407

# ── Envíopack (opcional, otro agregador) ───────────────────────
# ENVIOPACK_DEPOSITO=
