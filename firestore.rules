rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Catálogo público (incluye productos importados del POS).
    match /productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categorías: lectura pública (menú de la tienda), escritura admin.
    match /categorias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Perfiles: cada quien el suyo; el admin, todos.
    match /usuarios/{uid} {
      allow read, write: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Datos internos del local: solo admin.
    match /ventas/{id}       { allow read, write: if isAdmin(); }
    match /compras/{id}      { allow read, write: if isAdmin(); }
    match /proveedores/{id}  { allow read, write: if isAdmin(); }
    match /cajaSesiones/{id}  { allow read, write: if isAdmin(); }

    // Pedidos: crea cualquier usuario logueado; lee/actualiza su dueño o el admin.
    match /pedidos/{id} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin() ||
        (isSignedIn() && resource.data.usuarioId == request.auth.uid);
    }
  }
}
